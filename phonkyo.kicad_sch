				(size 0.508 0.508)
			)
			(justify left top)
			(href "https://www.ti.com/lit/ds/symlink/pcm5102a.pdf?ts=1728009135968&ref_url=https%253A%252F%252Fwww.ti.com%252Fproduct%252FPCM5102A for more details")
		)
		(uuid "324af228-9f51-44e2-99d2-afec861dd9cc")
	)
